# Server
NODE_ENV=development
PORT=5000
HOST=localhost

# MongoDB
MONGODB_URI=mongodb://localhost:27017/blockroll
DB_NAME=blockroll

# JWT
JWT_SECRET=change_this_to_a_random_32plus_char_secret
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change_this_to_a_different_random_secret
REFRESH_TOKEN_EXPIRES_IN=30d

# Blockchain (BlockDAG)
BLOCKCHAIN_RPC_URL=https://rpc.primordial.bdagscan.com
BLOCKCHAIN_CHAIN_ID=1
BLOCKROLL_CONTRACT_ADDRESS=
API_KEY_MANAGER_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_NETWORK=blockdag

# Encryption
ENCRYPTION_KEY=change_this_to_a_random_32_char_key
ENCRYPTION_ALGORITHM=aes-256-gcm

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Uploads
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin
ADMIN_WALLET_ADDRESS=

# Email (optional)
EMAIL_SERVICE=smtp
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@blockroll.io
EMAIL_ADMIN=admin@blockroll.io
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false

# App
APP_BASE_URL=http://localhost:3000
APP_NAME=BlockRoll
